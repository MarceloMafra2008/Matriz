//Elabore um programa que manipule com uma matriz 4 x 4 de inteiros, 
//conte e escreva quantos valores maiores que 10 ela possui.
#include <stdio.h>
#include <string.h>

int main()
{
    int mat[4][4], i, j, cont=0;
    
    for(i=0; i<4; i++)
    {
        for(j=0;j<4;j++)
        {
            printf("\nInsira valores para a matriz[%d][%d]:", i, j);
            scanf("%d", &mat[i][j]);
        }
    }
    printf("\n");
    
    for(i=0; i<4; i++)
    {
        for(j=0; j<4; j++)
        {
            printf("\n[%d][%d]:%d", i, j, mat[i][j]);
        }
    }
    for(i=0; i<4; i++)
    {
        for(j=0; j<4; j++)
        {
            if(mat[i][j]>10)
            {
                printf("\nmat[i][j]>10, [%d][%d]=%d", i, j, mat[i][j]);
                cont ++;
            }
        }
        
    }
    printf("\n");
    printf("\nQuantidade de valores maiores que 10:%d", cont);
    
    
}
