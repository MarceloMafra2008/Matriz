//Faça um programa que manipule com uma matriz 4 x 4 de inteiros, usuario insira valores para a matriz
//imprima a matriz e retorne a localização (linha e a coluna) do maior valor. 

#include <stdio.h>
int main()
{
    int mat[4][4], i, j, maior, linha=0, coluna=0;
    
    
    for(i=0; i<4; i++)
    {
        for(j=0; j<4; j++)
        {
            printf("\nInsira valores para a matriz[%d][%d]:", i, j);
            scanf("%d", &mat[i][j]);
        }
    }
    printf("\n");
    
    
    for(i=0; i<4; i++)
    {
        for(j=0; j<4; j++)
        {
            printf("\nMAT[%d][%d]=%d", i, j, mat[i][j]);
        }
    }
    maior=mat[0][0];
    for(i=0; i<4; i++)
    {
        for(j=0; j<4; j++)
        {
            if(mat[i][j]>maior)
            {
               maior=mat[i][j];
               linha = i;
               coluna = j;
            }
        }
    }
    printf("\nMatriz Maior[%d][%d]=%d", linha, coluna, maior);
}
