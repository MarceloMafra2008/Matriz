//Faça um programa que preenche uma matriz 4 x 4  de inteiros com o produto do valor da linha e da coluna de cada elemento. 
//Em seguida, imprima na tela a matriz. 
#include <stdio.h>
int main()
{
    int mat[4][4], i, j;
    
    printf("\n");
    for(i=0; i<4; i++)
    {
        for(j=0; j<4; j++)
        {
            mat[i][j] = i*j;
        }
    }
    printf("\n");
    for(i=0; i<4; i++)
    {
        for(j=0; j<4; j++)
        {
            printf("\nmat[%d][%d]=%d", i, j, mat[i][j]);
        }
    }
}
